# Copy this file to .env and adjust values as needed.

COMPOSE_PROJECT_NAME=xampp
# Moodle 5.3 requires PHP 8.3+; 8.3 is the tested default.
PHP_VERSION=8.3

# Versions downloaded by the wp and moodle helpers.
WORDPRESS_VERSION=7.1.5
MOODLE_VERSION=5.3.1

# 127.0.0.1 keeps the stack off your LAN. Use 0.0.0.0 to expose it.
BIND_ADDRESS=127.0.0.1

WEB_PORT=80
DB_PORT=3306
DB_ROOT_PASSWORD=root
DB_DATABASE=dev
DB_USER=dev
DB_PASSWORD=dev

PMA_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

JENKINS_PORT=8081
JENKINS_AGENT_PORT=50000

# develop = better error output; debug = also connect to VS Code on port 9003; off = fastest
XDEBUG_MODE=develop
TZ=UTC

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin123!
MOODLE_ADMIN_EMAIL=admin@example.test

# Docker Hub publishing: stack.cmd login, then stack.cmd push [php|jenkins|all].
# Use a Docker Hub access token as the password for login.
DOCKERHUB_USER=
DOCKERHUB_REPO=xampp
# Set these to run the published images instead of building them locally:
# PHP_IMAGE=youruser/xampp-php:8.3
# JENKINS_IMAGE=youruser/xampp-jenkins:lts
