# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows command scripts require CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts, configs, dockerfiles must use LF
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.editorconfig text eol=lf
